{
  "manifest_version": 3,
  "name": "BoardBooks Helper",
  "version": "1.0",
  "permissions": ["tabs", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://boardbooks.vanin.be/Pages/ViewItem.aspx*"],
      "js": ["content.js"]
    }
  ]
}
