{
  "manifest_version": 3,
  "name": "Vanin Boardbook Downloader",
  "version": "1.2",
  "permissions": ["tabs", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "https://boardbooks.vanin.be/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://boardbooks.vanin.be/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nig@ga.com"
    }
  }
}
